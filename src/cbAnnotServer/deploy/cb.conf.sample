# UCSC Cell Browser site configuration
#
# This is the Cell Browser's analog of the Genome Browser's hg.conf, but it is
# read by the web frontend (cellBrowser.js) in the browser, so it must contain
# NO secrets. Deploy it into the web document root (e.g.
# /usr/local/apache/htdocs-cells/cb.conf). cbUpgrade does not touch it, so you
# can change it on a mirror or sandbox without a code release.
#
# Format: key=value, one per line. Blank lines and lines starting with # are
# ignored. A missing cb.conf is fine — the frontend falls back to its built-in
# defaults (same behavior as an empty file).

# Where the data files live, if not in the directory this page was served from.
# This lets a docroot hold only the code (index.html, js/, css/, cb.conf) and
# read its datasets from a shared data directory, instead of duplicating them.
# It covers everything in the data tree: the dataset directories, search.json,
# genes/ and downloads/markers/. The code's own files, and this cb.conf, are
# always read from the directory serving the page.
#   empty / absent = data sits next to the code (the normal install)
#   a URL          = another server, e.g. a personal sandbox reading the shared
#                    tree. Crosses origins, so that server must send
#                    Access-Control-Allow-Origin:
#                      dataRoot=https://cells.ucsc.edu
#   a path         = another directory on this same server, via an Apache Alias.
#                    Stays same-origin, so no CORS header needed:
#                      dataRoot=/cells-data
dataRoot=

# Base URL of the login / annotation API (the cbAnnotServer backend).
#   empty  = same host as this page. Apache proxies /api to the local gunicorn.
#            This is the normal production setup on cells.ucsc.edu.
#   a URL  = use another server's login service, for a mirror or sandbox that
#            does not run its own backend, e.g.:
#              annotApiBase=https://cells.ucsc.edu
annotApiBase=

# Show the login / account system in the web frontend (the sign-in menu, plus
# saving and sharing custom annotations). This feature is still being finished,
# so it is gated here like a Genome Browser hg.conf feature flag and defaults to
# OFF. Turn it on only on sites where it is ready to be seen; leave it off (or
# absent) everywhere else so the unfinished login does not appear.
#   on / true / 1 / yes       = show the login UI
#   off / anything / absent   = hide it
showLogin=off

# Show the on-the-fly differential expression feature (Redmine #24912): the
# "Differential expression" item in the Tools menu and the Tools tab. Like
# showLogin, this is a feature flag that defaults to OFF, so the still-in-
# progress DE UI does not appear on installs that have not opted in. Turn it on
# only where it is ready to be seen.
#   on / true / 1 / yes       = show the DE feature
#   off / anything / absent   = hide it
# Note: even with the UI shown, the statistics are placeholder until deUrl below
# points at a real compute backend.
showDiffExp=off

# Endpoint for the on-the-fly differential expression backend (Redmine #24912).
# The frontend POSTs a DE job spec here and polls the same URL for status and
# results. This is a site-wide service (one backend per server), so it belongs
# here and not in any dataset's cellbrowser.conf.
#   absent / empty = no backend: the "Differential expression" tool still opens
#                    and builds groups, but a run produces placeholder results
#                    so the UI can be demoed before the backend is deployed.
#   a URL          = use this DE service, e.g.:
#                      deUrl=https://cells.ucsc.edu/cgi-bin/cbDe
deUrl=
