# Runtime environment for the DE worker (deWorker.py) and the dev-side submit
# blueprint. Copy to a non-world-readable file (e.g.
# /hive/data/inside/cells/cbAnnotServer/de.env) and point DE_ENV_FILE at it from
# the cron watchdog / systemd unit. All keys are optional; defaults in parentheses.

# --- worker: queue + compute -------------------------------------------------
# Shared job queue on /hive (the submit blueprint writes specs here).
DE_JOBS_DIR=/hive/data/inside/cells/deJobs

# The python that has scanpy/anndata/scipy — RELOCATE this off any personal home
# so the otto account can read it (see de/README.md "Durability").
DE_WORKER_PYTHON=/hive/data/inside/cells/cbAnnotServer/scanpyenv/bin/python

# Where the worker reads expression from. The cbBuild web output (exprMatrix.bin)
# is preferred; the .h5ad dir is only the fallback.
DE_CBBUILD_DIR=/usr/local/apache/htdocs-cells
DE_DATASETS_DIR=/hive/data/inside/cells/datasets

# Bound per-group cells tested (one-vs-rest guard); 0 disables. (50000)
#DE_MAX_CELLS_PER_GROUP=50000
# Per-job wall-clock cap, seconds. (600)
#DE_JOB_TIMEOUT=600

# --- worker: liveness (used by the cron watchdog) ----------------------------
DE_WORKER_PIDFILE=/hive/data/inside/cells/cbAnnotServer/run/deWorker.pid
DE_WORKER_HEARTBEAT=/hive/data/inside/cells/cbAnnotServer/run/deWorker.heartbeat
DE_WORKER_LOG=/hive/data/inside/cells/cbAnnotServer/logs/deWorker.log
# Watchdog restarts if the heartbeat is older than this. Defaults to
# DE_JOB_TIMEOUT + 300 so a legitimately long job is never mistaken for a hang.
#DE_WORKER_MAXSTALE=900
