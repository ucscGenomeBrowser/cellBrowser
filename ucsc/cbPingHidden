# rather than at whoever happened to send it.
REPLY_TO_EMAIL = "cells@ucsc.edu"

# how long a dataset may stay quiet before we write again
MIN_AGE_DAYS = 365

SUBJECT_TEMPLATE = 'UCSC Cell Browser: is "{label}" ready to be made public?'

EMAIL_TEMPLATE = """Dear {first_name},

